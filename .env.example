# ============================================================
# Popdex ↔ Lighter 对冲脚本配置
# 复制为 .env 后填写(或直接启动后在网页向导里完成全部配置)。
# 注意:默认参数为新手推荐值,刻意与作者配置不同;请按自己的资金与习惯微调,
#       避免与他人完全相同的参数/频率运行。
# ============================================================

# ---------- 总开关(默认实盘) ----------
# false + ACK=true = 实盘;想先模拟改成 DRY_RUN=true 重启
DRY_RUN=false
LIVE_TRADING_ACK=true

# ---------- 交易对与数量 ----------
# 策略模式: arb=套利(价差达标才出手,推荐) hedge=跨所对冲刷量 volume=Popdex单所刷量
STRATEGY_MODE=arb
# Lighter symbol / Popdex symbol 必须指同一个标的
LIGHTER_SYMBOL=ETH
POPDEX_SYMBOL=ETHUSDT
# 目标金额(USDT/轮):>0 时自动按盘口换算数量,优先于 ORDER_QTY(网页参数面板可改)
ORDER_NOTIONAL_USDT=50
# 每轮 maker 单数量(base 币),仅当目标金额为 0 时使用
ORDER_QTY=0.02
# 单边净敞口上限(base 币)。超过即触发 reduce-only 强制回平
MAX_NET_POSITION=0.08

# ---------- 策略参数 ----------
# Popdex maker 挂单:post-only,挂在同侧最优价向外偏移 offset 个 quote 单位
MAKER_OFFSET=0.05
# 盘口漂移超过该值则撤单重挂(quote 单位)
REQUOTE_THRESHOLD=0.5
# maker 单挂出后最长等待秒数,超时撤单
FILL_TIMEOUT_SEC=90
# Lighter 对冲单(IOC)允许的最大滑点(bps,1bp=0.01%)
HEDGE_MAX_SLIPPAGE_BPS=35
# 行情轮询间隔秒;持仓核对间隔秒
POLL_INTERVAL_SEC=0.7
POSITION_CHECK_SEC=2.5
# 连续失败 N 次后熔断停机
MAX_CONSECUTIVE_ERRORS=5

# ---------- Popdex(Morph Tachyon 链) ----------
# 主网 chainId=2184,测试网 chainId=34952 / https://testnet-api.popdex.xyz
POPDEX_API_URL=https://api.popdex.xyz
POPDEX_WS_URL=wss://ws.popdex.xyz/v1/ws/public
POPDEX_CHAIN_ID=2184
# 系统预编译合约地址(官方文档固定值,勿改)
POPDEX_ORDER_CONTRACT=0x0000000000000000000000000000000000001000
# 你的 Popdex 主账户(持仓/资金所在地址,即网页连接的钱包)
POPDEX_ACCOUNT_ADDRESS=
# Agent 钱包私钥(由 authorize_agent.py 授权,只拿交易权、拿不走资金)
# 注意:这里填的是 Agent 私钥,不是主账户私钥!
POPDEX_SIGNER_PRIVATE_KEY=
# builder(返佣)地址与费率,0 = 不使用
POPDEX_BUILDER_ADDRESS=0x0000000000000000000000000000000000000000
POPDEX_BUILDER_FEE_RATE=0
# 刷量模式:两轮间隔秒(链上限速,建议≥3)
VOLUME_ROUND_INTERVAL=8

# ---------- Lighter ----------
LIGHTER_BASE_URL=https://mainnet.zklighter.elliot.ai
LIGHTER_ACCOUNT_INDEX=
LIGHTER_API_KEY_INDEX=0
LIGHTER_API_PRIVATE_KEY=
